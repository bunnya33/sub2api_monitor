<Application x:Class="QuotaMonitor.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#26322e" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64716c" />
    <SolidColorBrush x:Key="LineBrush" Color="#e0e6e2" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Background" Value="#f1f5f3" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
